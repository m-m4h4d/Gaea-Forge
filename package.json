{
  "name": "gaea-forge",
  "version": "1.0.0",
  "description": "Local-First, Open-Source World-Building Platform",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "tauri": "npx @tauri-apps/cli",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "test": "npm run test --workspace=web",
    "test:e2e": "npm run test:e2e --workspace=web"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1"
  }
}
